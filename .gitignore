# pixi environments
.pixi/*
!.pixi/config.toml

# lecture build outputs (regenerated by `make` in lectures/), except the finished decks
lectures/build/*
!lectures/build/cee_l*.pptx
!lectures/build/cee_l*.pdf
# ... and the numbers each deck was written from, which the notebooks check themselves against
!lectures/build/fig/
lectures/build/fig/*
!lectures/build/fig/cee_l*/
lectures/build/fig/cee_l*/*
!lectures/build/fig/cee_l*/numbers.json
!lectures/build/fig/cee_l25_agents/transcripts.jsonl

# data: downloaded and derived by scripts/fetch_*.sh (data/raw is read-only)
data/

# Python caches and experiment outputs
__pycache__/
*.py[cod]
.ipynb_checkpoints/
outputs/
wandb/
*.pt
*.pth
*.ckpt
*.pkl

# credentials and local settings
.env
.env.*
.vscode/

# third-party copyrighted material, kept locally for reference only
slides/
book/
978-3-030-18114-7.pdf

# interrupted downloads and atomic writes
*.part

# editors and OS
.DS_Store
*~
